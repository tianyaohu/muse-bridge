<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- cp to ~/Library/LaunchAgents/ ; launchctl load -w ~/Library/LaunchAgents/ai.nori.muse-bridge.plist -->
<plist version="1.0"><dict>
  <key>Label</key><string>ai.nori.muse-bridge</string>
  <key>ProgramArguments</key><array>
    <string>/bin/bash</string><string>-lc</string>
    <string>cd ~/muse-bridge &amp;&amp; ./run.sh</string>
  </array>
  <key>RunAtLoad</key><true/><key>KeepAlive</key><true/>
  <key>StandardOutPath</key><string>/tmp/muse-bridge.log</string>
  <key>StandardErrorPath</key><string>/tmp/muse-bridge.err</string>
</dict></plist>
