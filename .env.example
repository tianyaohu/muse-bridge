# Copy to .env and run: chmod 600 .env
# Never commit .env. Values below are placeholders. Documented defaults are in
# docs/ARCHITECTURE.md. USEAPI_TOKEN belongs in nori-to-muse/.env, not here.

# Inbox root. Default is ./data, or MUSE_BRIDGE_INBOX when DATA_DIR is unset.
MUSE_BRIDGE_DATA_DIR=./data
# MUSE_BRIDGE_INBOX=./data

# Bind address for local runs. Docker and Fly set 0.0.0.0 and port 8080.
MUSE_BRIDGE_HOST=127.0.0.1
MUSE_BRIDGE_PORT=8765

# Echoed by /healthz. Leave unset to keep the historical name.
# MUSE_BRIDGE_SERVER_NAME=nori-muse-bridge
# MUSE_BRIDGE_SERVER_TITLE=Nori Muse Bridge
# MUSE_BRIDGE_INSTRUCTIONS=

# Legacy single-user mode. Off by default. Turn on only for the original
# shared-token setup, and set the token with openssl rand -hex 24.
MUSE_BRIDGE_LEGACY_SINGLE_TOKEN=0
MUSE_BRIDGE_TOKEN=replace-with-openssl-rand-hex-24
# MUSE_BRIDGE_LEGACY_USER=legacy

# ?key= is ignored unless this is 1. Prefer Authorization: Bearer or X-API-Key.
MUSE_BRIDGE_ALLOW_QUERY_KEY=0

# Public origin for OAuth metadata. Empty keeps the request Host.
MUSE_BRIDGE_PUBLIC_URL=
MUSE_BRIDGE_OAUTH_ISSUER=

# Retention. 90 days, then delete. 0 keeps records until a user or admin deletes them.
# Purge runs only when the interval is greater than 0, or via muse_bridge.admin purge.
MUSE_BRIDGE_RETENTION_DAYS=90
MUSE_BRIDGE_PURGE_INTERVAL_SECONDS=0

# Optional fan-out after a record is stored. NORI_WEBHOOK_URL and
# NORI_WEBHOOK_SECRET are fallbacks when the MUSE_BRIDGE_ names are unset.
MUSE_BRIDGE_WEBHOOK_URL=
MUSE_BRIDGE_WEBHOOK_SECRET=replace-with-openssl-rand-hex-24

# Rate and payload limits. Off until this is 1. The middleware then reads the
# three numeric settings (60 requests per 60 seconds, 1 MiB body).
MUSE_BRIDGE_LIMITS_ENABLED=0
MUSE_BRIDGE_RATE_LIMIT=60
MUSE_BRIDGE_RATE_WINDOW_SECONDS=60
MUSE_BRIDGE_MAX_BODY_BYTES=1048576

# sync_inbox.py. API_KEY is preferred. TOKEN is the legacy bearer.
# MUSE_BRIDGE_URL=https://muse-bridge.example.com
# MUSE_BRIDGE_API_KEY=replace-with-mb-key
# MUSE_BRIDGE_SYNC_INBOX=./inbox
